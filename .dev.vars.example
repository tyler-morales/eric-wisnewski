# Copy to .dev.vars and fill in. Used by: npx wrangler pages dev ./public --d1 COMMENTS_DB=<database_id>
# Turnstile test secret (always passes). Omit to skip verification in dev.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional: for admin comment moderation at /admin/comments/
# COMMENTS_ADMIN_SECRET=your-secret
# Photo ingest at /add-photos/ (never commit real values)
# UPLOAD_SECRET=pick-a-long-password
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=tyler-morales/eric-wisnewski
# Newsletter (Resend + dispatch cron). Omit until domain is verified in Resend.
# RESEND_API_KEY=re_xxx
# NEWSLETTER_DISPATCH_SECRET=openssl-rand-hex-32
# NEWSLETTER_FROM_EMAIL=hello@ericwisnewski.com
# NEWSLETTER_POSTAL_ADDRESS=Your Name, City, ST
